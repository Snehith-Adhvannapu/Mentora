# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Google Gemini AI API Key (Required for AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Optional - uses memory storage by default)
# DATABASE_URL=postgresql://username:password@localhost:5432/mentora

# Application Environment
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Optional: External Service APIs
# Add any additional API keys your deployment might need